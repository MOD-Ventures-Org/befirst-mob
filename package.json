{
  "name": "befirst-pose-module-shell",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-video-thumbnails"
        ]
      }
    }
  },
  "scripts": {
    "start": "expo start ",
    "android": "expo run:android",
    "ios": "expo run:ios --device",
    "prebuild": "expo prebuild",
    "fetch:model": "node scripts/fetch-mediapipe-model.mjs",
    "benchmark:model:heavy": "node scripts/fetch-mediapipe-model.mjs heavy",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand"
  },
  "dependencies": {
    "@shopify/react-native-skia": "2.2.12",
    "expo": "~54.0.0",
    "expo-image-picker": "~17.0.11",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-mediapipe": "^0.6.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-vision-camera": "^4.7.3",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.10",
    "babel-jest": "29.7.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "~54.0.12",
    "jest": "29.7.0",
    "typescript": "~5.9.2"
  }
}
