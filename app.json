{
  "expo": {
    "name": "Befirst Pose Module",
    "slug": "befirst-pose-module",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "befirstpose",
    "ios": {
      "bundleIdentifier": "com.local.befirstpose",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera for live pose tracking."
      }
    },
    "android": {
      "package": "com.local.befirstpose",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "./plugins/with-mediapipe-model",
      [
        "expo-dev-client",
        {
          "launchMode": "most-recent"
        }
      ],
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "Allow $(PRODUCT_NAME) to access your camera for live pose tracking.",
          "enableMicrophonePermission": false
        }
      ]
    ],
    "assetBundlePatterns": [
      "**/*"
    ]
  }
}
