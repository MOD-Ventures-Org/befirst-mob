{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ]
    },
    "types": [
      "react-native"
    ]
  },
  "include": [
    "App.tsx",
    "declarations.d.ts",
    "src/pose-module/index.ts",
    "src/pose-module/hooks/usePoseSession.ts",
    "src/pose-module/screens/components/DebugPanel.tsx",
    "src/pose-module/screens/components/PermissionPlaceholder.tsx",
    "src/pose-module/screens/components/SkiaSkeletonOverlay.tsx"
  ],
  "exclude": [
    "node_modules",
    "ios",
    "android",
    "src/pose-module/**/__tests__/**"
  ]
}
